{
    "name": "yt-dlp-web-ui-devcontainer",
    "image": "mcr.microsoft.com/devcontainers/go:1",
    "features": {
        "ghcr.io/devcontainers-extra/features/pnpm:2": {},
        "ghcr.io/devcontainers-extra/features/claude-code:1": {},
        "ghcr.io/devcontainers-extra/features/yt-dlp:2": {},
        "ghcr.io/devcontainers-extra/features/ffmpeg-apt-get:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "mounts": [
        {
            "source": "devcontainer-bash-history",
            "target": "/cmdhistory",
            "type": "volume"
        },
        {
            "source": "devcontainer-claude-code",
            "target": "/claude-persist",
            "type": "volume"
        },
        {
            "source": "devcontainer-gh-cli",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        }
    ],
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "remoteEnv": {
        "EDITOR": "code",
        "VISUAL": "code",
        "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
        "ANTHROPIC_AUTH_TOKEN": "${localEnv:ANTHROPIC_AUTH_TOKEN}"
    }
}